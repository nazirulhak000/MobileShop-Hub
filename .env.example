# SQLite path is relative to prisma/ (prisma/dev.db). Required: schema.prisma uses env("DATABASE_URL").
# Tests (npm test / npm run test:e2e) override this with an isolated database under .local/tests.
DATABASE_URL="file:./dev.db"
APP_ORIGIN=http://localhost:3000
# Generate a random secret of at least 32 characters. Do not commit the real value.
AUTH_SECRET=
# Local development only. Production always rejects this adapter.
OTP_DEV_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Set to "true" ONLY behind a reverse proxy that overwrites X-Forwarded-For (used for per-IP rate limits).
TRUST_PROXY=false
# Bearer secret (>= 32 chars) for POST /api/cron/cleanup. Schedule it hourly. Leave empty to disable the endpoint.
CRON_SECRET=
# prisma/seed.ts safety switches (never use on production data)
# SEED_PASSWORD: password (>= 12 chars) for seeded demo users; random + printed once if empty
SEED_PASSWORD=
# SEED_RESET=true wipes seeded tables before seeding
SEED_RESET=false
# ALLOW_SEED=true bypasses the production / non-sqlite guard
ALLOW_SEED=false
