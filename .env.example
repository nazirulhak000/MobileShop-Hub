# ==============================================================================
# FixMe POS & Repair Management - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma)
# ------------------------------------------------------------------------------
# [Local Development / SQLite]
# Relative to prisma/ folder (prisma/dev.db). Note: Vercel serverless does NOT support SQLite.
DATABASE_URL="file:./dev.db"

# [Cloud Production / PostgreSQL (Neon / Supabase / AWS RDS)]
# For Vercel Serverless deployments, use PostgreSQL with Connection Pooling.
# Neon Example (Pooled):
# DATABASE_URL="postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/fixmedb?sslmode=require"
# DIRECT_URL="postgres://user:password@ep-sample.us-east-2.aws.neon.tech/fixmedb?sslmode=require"
#
# Supabase Example (Transaction Pooler port 6543):
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
# DIRECT_URL=

# ------------------------------------------------------------------------------
# 2. APPLICATION & AUTHENTICATION SECURITY
# ------------------------------------------------------------------------------
# Public URL of the application. Required for CSRF Origin validation on mutations.
# Local: http://localhost:3000
# Production: https://fixme.yourdomain.com or https://your-app.vercel.app
APP_ORIGIN=http://localhost:3000

# Secret key for session cookies, token hashes, and HMAC validation.
# MUST be a cryptographically random string >= 32 characters.
# Generate on Unix/macOS: openssl rand -base64 32
# Generate on Windows PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | ForEach-Object {[char]$_})
AUTH_SECRET=

# Set to "true" on Vercel or when behind a reverse proxy that safely sets X-Forwarded-For.
# Used for IP-based rate limiting (AuthThrottle). Set to "true" for Vercel.
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 3. BACKGROUND MAINTENANCE & VERCEL CRON
# ------------------------------------------------------------------------------
# Bearer secret (>= 32 chars) for GET/POST /api/cron/cleanup.
# Vercel Cron automatically sends: Authorization: Bearer <CRON_SECRET>
# Leave empty to disable the maintenance endpoint.
CRON_SECRET=

# ------------------------------------------------------------------------------
# 4. CUSTOMER PORTAL OTP (Twilio SMS Provider)
# ------------------------------------------------------------------------------
# Local dev mock flag. When true, OTP code is returned on login page.
# ALWAYS set to false in production (enforced: production rejects true).
OTP_DEV_ENABLED=false

# Twilio SMS Credentials for production Thai SMS delivery.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# ------------------------------------------------------------------------------
# 5. DATABASE SEEDING SAFETY SWITCHES (prisma/seed.ts)
# ------------------------------------------------------------------------------
# NEVER use SEED_RESET or ALLOW_SEED on production databases with live data.
# SEED_PASSWORD: password (>= 12 chars) for demo users (admin/cashier/etc).
SEED_PASSWORD=
# SEED_RESET=true drops and recreates seeded records (destructive).
SEED_RESET=false
# ALLOW_SEED=true allows running seed on non-sqlite / production environments.
ALLOW_SEED=false
